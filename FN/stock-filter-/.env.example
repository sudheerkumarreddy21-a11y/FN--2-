# Copy to .env for local use (netlify dev). On Netlify set these in Site settings > Environment variables.

# Set REQUIRE_OTP=true to ask for an SMS OTP at sign-up/login (needs TWOFACTOR_API_KEY or OTP_DEV_MODE).
# Default (false/unset): users log in directly with User ID + password.
REQUIRE_OTP=false

# 2Factor.in API key (only used when REQUIRE_OTP=true) (sends the real SMS OTP)
TWOFACTOR_API_KEY=your-2factor-api-key

# Any long random text (16+ characters). Used to encrypt OTP tickets and sessions. Keep it secret.
SESSION_SECRET=change-me-to-a-long-random-string

# LOCAL TESTING ONLY: set to true to skip the SMS. The OTP is then printed in the terminal
# running the app (never shown in the browser). Ignored automatically on Netlify production.
OTP_DEV_MODE=false

# LOCAL TESTING ONLY: with OTP_DEV_MODE=true, also show the OTP on the login screen (no need to look at the terminal).
OTP_DEV_SHOW=false
